import os
from google import genai
from pydantic import BaseModel, Field

class ExtractedData(BaseModel):
    club_name: str = Field(description="The name of the suggested club")
    goal_one: str = Field(description = "Goal n1")
    goal_two: str = Field(description = "Goal n2")
    goal_three: str = Field(description = "Goal n3")
    seasons: int = Field(description="How many seasons the player will have to accomplish those goals you suggested?")
    sentiment: str = Field(description="Overall tone: Fun, challenging or exciting")
    game: str = Field(description="Game suggested: Fifa or Football Manager")


client = genai.Client(
    api_key=os.environ.get("GEMINI_API_KEY"),
)

generation_config = {
    'temperature': 1,
    'max_output_tokens': 65536,
    'top_p': 0.95,
    'thinking_level': 'medium',
}

input_sentiment = str(input("What sentiment do you want?"))
input_game = str(input("What game do you want?"))

interaction = client.interactions.create(
    model='models/gemini-3-flash-preview',
    input=f"""A player wanting a new save have just requested you a suggestion! Suggest him your top 1 suggestion, only. You have to provide details about your suggestion, such as club name, 3 goals to accomplish, how many seasons to accomplish those goals, and the sentiment (fun, challenging or excting). The new player wants a sentiment of {input_sentiment} and the game is {input_game}.""",
    system_instruction = "You are ChronicleFC. You are a virtual player, who have enjoyed over 10 years of gameplay in EA Fifa, FC and Football Manager games, as career mode. You have learned the most fun saves, as well as the most challenging, most exciting and most boring. You have accumulated much experience through your years of gameplay, that now you can guide players into saves that they will enjoy. This is your task for the rest of your life now. You guide new players on their next EA Fifa, FC, or Football Manager career mode saves.",
    generation_config=generation_config,
    response_format = {
        "type": "text",
        "mime_type": "application/json",
        "schema": ExtractedData.model_json_schema()
    },
)

# The model's response will be valid JSON adhering strictly to ExtractedData
print(interaction.output_text)
